{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "out-tsc/graph-edge",
    "module": "nodenext",
    "types": ["node"],
    "rootDir": "src",
    "moduleResolution": "nodenext",
    "tsBuildInfoFile": "out-tsc/graph-edge/tsconfig.app.tsbuildinfo"
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "out-tsc",
    "dist",
    "jest.config.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "eslint.config.js",
    "eslint.config.cjs",
    "eslint.config.mjs"
  ],
  "references": [
    {
      "path": "../../packages/sui-checkpoint-reader"
    },
    {
      "path": "../../packages/sdk/tsconfig.lib.json"
    }
  ]
}
